#!/usr/bin/env bb
;; Alice launcher — one private Transmission UI on a DigitalOcean Droplet.
;;
;; Desired state lives in colors.yml. Secrets are supplied only through
;; COLORS_PAR_* environment variables. COLORS_PAR_PROFILE is always refused.
;; Lifecycle logic lives in the tested alice library, not in this copied file.

(require '[babashka.fs :as fs]
         '[clojure.java.io :as io]
         '[clojure.string :as str])

(def script-dir
  (let [file (if (= "NO_SOURCE_PATH" *file*)
               (fs/path (fs/cwd) "green")
               (fs/path *file*))]
    (str (fs/parent (fs/canonicalize file)))))

(def ^:private launcher-contract 1)

;; Managed by `bb pin` — do not edit by hand. An initial nil is intentional:
;; the repository must be committed and pushed before a real SHA can be stamped.
(def ^:private alice-sha "6ba7116a816bea9d1b11b03611b1092bd4a18c6b")

(def ^:private alice-git-url "https://github.com/getcolors/alice.git")
(def ^:private green-git-url "https://github.com/getcolors/green.git")

(defn- lib-coord [env-var url sha deps-root]
  (if-let [root (System/getenv env-var)]
    {:local/root root}
    (when sha
      (cond-> {:git/url url :git/sha sha}
        deps-root (assoc :deps/root deps-root)))))

(def ^:private resolved?
  (some? (io/resource "io/github/getcolors/alice/tools.clj")))

(def ^:private bootstrap-error
  (when (and (System/getProperty "babashka.version") (not resolved?))
    (let [alice (lib-coord "ALICE_LIB_ROOT" alice-git-url alice-sha nil)
          green (lib-coord "GREEN_LIB_ROOT" green-git-url nil nil)]
      (if-not alice
        (str "this launcher carries no alice pin.\n"
             "It has not been stamped by `bb pin`, which cannot run until the "
             "alice repository has been pushed.\n"
             "Point it at a checkout meanwhile: ALICE_LIB_ROOT=/path/to/alice")
        (do ((requiring-resolve 'babashka.deps/add-deps)
             {:deps (cond-> {'io.github.getcolors/alice alice}
                      green (assoc 'io.github.getcolors/green green))})
            nil)))))

(def ^:private load-error
  (or bootstrap-error
      (try
        (require 'green.cli 'io.github.getcolors.alice.workflow)
        nil
        (catch Throwable t (or (ex-message t) (str (class t)))))))

(defn- alice-contract []
  (or (some-> (requiring-resolve 'io.github.getcolors.alice.utils/contract) deref)
      0))

(defn- contract-error []
  (let [resolved (if load-error 0 (alice-contract))]
    (when (< resolved launcher-contract)
      {:green/exit 2
       :green/err (str "this launcher requires alice contract " launcher-contract
                       " but resolved " resolved "\n"
                       (if alice-sha
                         (str "the pinned commit " (apply str (take 7 alice-sha))
                              " predates this launcher; update the skill or repin")
                         "no alice library could be resolved")
                       (when load-error (str "\n" load-error)))})))

(defn- find-up [name dir]
  (loop [dir (.getAbsoluteFile (io/file dir))]
    (when dir
      (let [candidate (io/file dir name)]
        (if (.exists candidate)
          (str candidate)
          (recur (.getParentFile dir)))))))

(defn- default-file []
  (or (find-up "colors.yml" ".")
      (let [beside-script (io/file script-dir "colors.yml")]
        (when (.exists beside-script) (str beside-script)))
      "colors.yml"))

(defn- file-arg? [arg]
  (or (= "-f" arg) (= "--file" arg)
      (str/starts-with? (str arg) "--file=")))

(defn default-args [args]
  (let [args (vec args)]
    (cond-> args
      (not-any? file-arg? args) (conj "-f" (default-file)))))

(def lifecycle-commands #{"build" "create" "delete" "validate" "describe"})

(def usage
  (str "Usage: green <build|create|delete|validate|describe> "
       "[-f|--file colors.yml] [--dry-run]\n"
       "       green tunnel [local-port]\n"
       "\n"
       "  build     render the work directory only — contact nothing\n"
       "  create    provision the Droplet, Transmission, SSH alias, and verify\n"
       "  delete    remove the SSH alias, then guarded infrastructure\n"
       "  validate  check all desired state, tools, and DigitalOcean access\n"
       "  describe  report SSH and Transmission status without changing state\n"
       "  tunnel    forward the private Transmission UI to loopback"))

(defn run [& args]
  (let [args (vec args)
        command (first args)]
    (cond
      (contains? #{"help" "--help" "-h"} command)
      {:green/exit 0 :green/err usage}

      (contains? lifecycle-commands command)
      (or (contract-error)
          ((requiring-resolve 'green.cli/run-cli)
           @(requiring-resolve 'io.github.getcolors.alice.workflow/workflow)
           (default-args args)))

      (= "tunnel" command)
      (or (contract-error)
          ((requiring-resolve 'io.github.getcolors.alice.operator/run)
           (default-file) (subvec args 1)))

      :else {:green/exit 2 :green/err usage})))

(defn -main [& args]
  (let [{:green/keys [exit err trace]} (apply run args)]
    (when err
      (binding [*out* (if (zero? (or exit 0)) *out* *err*)]
        (println err)
        (when trace (println trace))))
    (System/exit (or exit 0))))

(defn- launched-as-script? []
  (when-let [bb-file (System/getProperty "babashka.file")]
    (= (str (fs/canonicalize bb-file))
       (str (fs/canonicalize *file*)))))

(when (launched-as-script?)
  (apply -main *command-line-args*))
